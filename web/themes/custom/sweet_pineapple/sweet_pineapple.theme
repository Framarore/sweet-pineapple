|| ($current_region == 'contenttopcolumn3' && theme_get_setting('menu_contenttopcolumn3') == 0) 
|| ($current_region == 'contenttopcolumn4' && theme_get_setting('menu_contenttopcolumn4') == 0) 
|| ($current_region == 'contentbottomcolumn1' && theme_get_setting('menu_contentbottomcolumn1') == 0) 
|| ($current_region == 'contentbottomcolumn2' && theme_get_setting('menu_contentbottomcolumn2') == 0) 
|| ($current_region == 'contentbottomcolumn3' && theme_get_setting('menu_contentbottomcolumn3') == 0) 
|| ($current_region == 'contentbottomcolumn4' && theme_get_setting('menu_contentbottomcolumn4') == 0) 
|| ($current_region == 'footerabovecolumn1' && theme_get_setting('menu_footerabovecolumn1') == 0) 
|| ($current_region == 'footerabovecolumn2' && theme_get_setting('menu_footerabovecolumn2') == 0) 
|| ($current_region == 'footerabovecolumn3' && theme_get_setting('menu_footerabovecolumn3') == 0) 
|| ($current_region == 'footerabovecolumn4' && theme_get_setting('menu_footerabovecolumn4') == 0) 
|| ($current_region == 'footercellcolumn1' && theme_get_setting('menu_footercellcolumn1') == 0) 
|| ($current_region == 'footercellcolumn2' && theme_get_setting('menu_footercellcolumn2') == 0) 
|| ($current_region == 'footercellcolumn3' && theme_get_setting('menu_footercellcolumn3') == 0) 
|| ($current_region == 'footerbelowcolumn1' && theme_get_setting('menu_footerbelowcolumn1') == 0) 
|| ($current_region == 'footerbelowcolumn2' && theme_get_setting('menu_footerbelowcolumn2') == 0) 
|| ($current_region == 'footerbelowcolumn3' && theme_get_setting('menu_footerbelowcolumn3') == 0) 
|| ($current_region == 'footerbelowcolumn4' && theme_get_setting('menu_footerbelowcolumn4') == 0) 
 ) 
 { 
	if($items[$key]['below'])  {
		if ($item['url']->toString() == $current_path) 
		{	
		$variables['items'][$key]['attributes']['class'] = 'ttr_menu_items_parent_link_active_arrow dropdown-toggle';	
		} 
		else
		{ 
		$variables['items'][$key]['attributes']['class'] = 'ttr_menu_items_parent_link_arrow dropdown-toggle';
		} 
