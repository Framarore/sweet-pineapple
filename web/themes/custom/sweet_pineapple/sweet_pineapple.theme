		} 
	} 
	else
	{ 
		if ($item['url']->toString() == $current_path) 
		{	
		$variables['items'][$key]['attributes']['class'] = 'ttr_vmenu_items_parent_link_active'; 
		}
		else
		{	
		$variables['items'][$key]['attributes']['class'] = 'ttr_vmenu_items_parent_link';
		}
	}
}
}
}
} 
function sweet_pineapple_form_system_theme_settings_alter(&$form, Drupal\Core\Form\FormStateInterface $form_state) { 
$form['sweet_pineapple_content'] = array(
'#type' => 'details',
'#title' => t('Import Content'),
'#open' => TRUE,
'#markup' => '<br>',
'#description' => t('Click to add content page and menu'),
'#weight' => 0,
);
$form['sweet_pineapple_content']['content_import_options'] = array(
'#type' => 'submit',
'#value' => t('Import Content'),
 '#submit' => array('sweet_pineapple_add_content'),
'#ajax' => array(
  'callback' => 'sweet_pineapple_callback',
  'event' => 'click',
  'progress' => array(
    'type' => 'throbber',
    ),
  ),
);
$form['sweet_pineapple_content']['is_content_imported'] = array('#type' => 'hidden');
$is_content_imported = \Drupal::config('sweet_pineapple.settings')->get('is_content_imported');
if ($is_content_imported == '1')
{
	unset($form['sweet_pineapple_content']);
