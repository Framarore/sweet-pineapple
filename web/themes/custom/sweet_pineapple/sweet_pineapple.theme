function sweet_pineapple_get_theme_path($theme = 'sweet_pineapple') {
  return \Drupal::service('extension.list.theme')->getPath($theme);
}

function sweet_pineapple_preprocess_maintenance_page(&$variables) {
  if (!$variables['db_is_active']) {
    $variables['site_name'] = '';
  }
  // Carga los estilos del tema también en la pantalla de mantenimiento.
  $variables['#attached']['library'][] = 'sweet_pineapple/global-styling-and-scripts';
}
/**
* Adjunta la librería global del tema.
*/
function sweet_pineapple_page_alter(&$page) {
  $page['#attached']['library'][] = 'sweet_pineapple/global-styling-and-scripts';
}
function sweet_pineapple_preprocess_page(&$variables) {
  sweet_pineapple_apply_content_translation_updates();
  $variables['theme_path'] = sweet_pineapple_get_theme_path(\Drupal::theme()->getActiveTheme()->getName());
  $variables['base_path'] = base_path();
  $variables['front_page'] = Url::fromRoute('<front>')->toString();
  $variables['sp_account_link_url'] = \Drupal::currentUser()->isAnonymous()
    ? Url::fromRoute('user.login')->toString()
    : Url::fromRoute('user.logout')->toString();
  $variables['sp_account_link_title'] = \Drupal::currentUser()->isAnonymous()
    ? 'Iniciar sesión'
    : 'Cerrar sesión';
  $is_store_catalog = \Drupal::service('path.current')->getPath() === '/tienda';
  $variables['sp_store_options'] = $is_store_catalog && \Drupal::hasService('sweet_pineapple_management.store_insights')
    ? \Drupal::service('sweet_pineapple_management.store_insights')->getStoreOptions()
    : [];
  $variables['sp_featured_products'] = $is_store_catalog && \Drupal::hasService('sweet_pineapple_ai_recommender.recommender')
    ? \Drupal::service('sweet_pineapple_ai_recommender.recommender')->getFeaturedProducts()
    : [];
}

function sweet_pineapple_preprocess_views_view_fields(&$variables) {
  if (($variables['view']->id() ?? '') !== 'tienda' || ($variables['view']->current_display ?? '') !== 'page_1') {
    return;
  }

  $variables['sp_store_ids'] = '';
  $entity = $variables['row']->_entity ?? NULL;
  if (!$entity || !\Drupal::hasService('sweet_pineapple_management.store_insights')) {
    return;
  }

  $map = &drupal_static(__FUNCTION__ . ':product_store_map');
  if ($map === NULL) {
    $map = \Drupal::service('sweet_pineapple_management.store_insights')->getProductStoreMap();
  }

  $product_id = (int) $entity->id();
  if (!empty($map[$product_id])) {
    $variables['sp_store_ids'] = implode(' ', array_map('strval', $map[$product_id]));
  }
}

function sweet_pineapple_preprocess_commerce_product(&$variables) {
  if (isset($variables['attributes']) && $variables['attributes'] instanceof Attribute) {
    $variables['attributes']->addClass('sp-product-detail');
  }
}
