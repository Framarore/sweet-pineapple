{{ attach_library('sweet_pineapple/store-browser') }}
{% set theme_path = base_path ~ active_theme_path() %}
{% set theme_path1 = theme_path ~ '/content' %}
<div class="ttr_banner_menu"></div>
<div id="ttr_menu"> 
<div class="margin_collapsetop"></div>
<nav class="navbar-default navbar-expand-md navbar">
<div id="ttr_menu_inner_in"> 
<div class="ttr_menu_element_alignment container">
<div class="ttr_images_container">
<div class="ttr_menu_logo">
<a href="{{ front_page }}">
<img src="{{ theme_path  ~ '/images/sweet-pineapple-profile.jpg' }}" alt="{{ 'Home'|t }}"class="" />
</a>
</div>
</div>
<div id="navigationmenu">
<div class="navbar-header">
<button id="nav-expander" data-target=".navbar-collapse" data-toggle="collapse" class="navbar-toggle" type="button">
<span class="ttr_menu_toggle_button">
<span class="sr-only">
</span>
<span class="icon-bar">
</span>
<span class="icon-bar">
</span>
<span class="icon-bar">
</span>
</span>
<span class="ttr_menu_button_text">
{{ 'Menu'|t }}
</span>
</button>
</div>
<div class="menu-center collapse navbar-collapse">
{{ page.primary_menu }}
</div>
<div class="ttr_images_container">
</div>
</div>
</div>
</div>
</nav>
</div>
<div class="margin_collapsetop"></div>
<div id="ttr_page" class="container">
<div id="ttr_content_and_sidebar_container">
<div id="ttr_content">
<div id="ttr_html_content_margin" class="container-fluid">
<div class="margin_collapsetop"></div>
{% if breadcrumb %}
{{ breadcrumb }}
{% endif %}
<div style="clear:both;">
</div>
{% if tabs %}
<div style="clear:both;" class="tabs">{{ tabs }}</div>
{% endif %}
{{ page.help }}
{{ page.messages }}
{% if (action_links) %}
<ul class="action-links">{{ action_links }}</ul>{% endif %}
<section class="sp-store-assistant-callout">
  <div class="sp-store-assistant-callout__inner">
    <p class="sp-store-assistant-callout__eyebrow">{{ 'Prototipo TFG'|t }}</p>
    <h2>{{ 'Prueba el recomendador inteligente de productos'|t }}</h2>
    <p>{{ 'Responde unas preguntas y descubre qué productos del catálogo encajan mejor con la ocasión, el sabor y el número de personas.'|t }}</p>
    <a class="sp-store-assistant-callout__link" href="/tienda/recomendador" data-sp-recommender-link>{{ 'Abrir recomendador'|t }}</a>
  </div>
</section>
{% if sp_featured_products %}
<section class="sp-store-featured" aria-labelledby="sp-store-featured-title">
  <div class="sp-store-browser__header">
    <p class="sp-store-browser__eyebrow">{{ 'Selección especial'|t }}</p>
    <h2 id="sp-store-featured-title">{{ 'Productos destacados'|t }}</h2>
  </div>
  <div class="sp-store-featured__grid">
    {% for product in sp_featured_products %}
      <article class="sp-store-featured__card">
        {% if product.image_url %}
          <a class="sp-store-featured__image" href="{{ product.url }}">
            <img src="{{ product.image_url }}" alt="{{ product.title }}">
          </a>
        {% endif %}
        <div class="sp-store-featured__body">
          <p class="sp-store-featured__badge">{{ loop.first ? 'Top tienda'|t : 'Destacado'|t }}</p>
          <h3>{{ product.title }}</h3>
          <p>{{ product.summary }}</p>
          <a href="{{ product.url }}">{{ 'Ver producto'|t }}</a>
        </div>
      </article>
    {% endfor %}
  </div>
</section>
{% endif %}
<section class="sp-store-browser" data-sp-store-browser>
  <div class="sp-store-browser__header">
    <p class="sp-store-browser__eyebrow">{{ 'Catálogo Sweet Pineapple'|t }}</p>
    <h2>{{ 'Explora por familia y afina por sabor, ocasión o estilo'|t }}</h2>
  </div>
  <div class="sp-store-browser__tabs" role="tablist" aria-label="{{ 'Familias de productos'|t }}">
    <button type="button" class="sp-store-browser__tab is-active" data-sp-family="all">{{ 'Todo'|t }} <span data-sp-count="all"></span></button>
    <button type="button" class="sp-store-browser__tab" data-sp-family="tartas">{{ 'Tartas'|t }} <span data-sp-count="tartas"></span></button>
    <button type="button" class="sp-store-browser__tab" data-sp-family="cookies">{{ 'Cookies'|t }} <span data-sp-count="cookies"></span></button>
    <button type="button" class="sp-store-browser__tab" data-sp-family="brownies">{{ 'Brownies'|t }} <span data-sp-count="brownies"></span></button>
    <button type="button" class="sp-store-browser__tab" data-sp-family="mini">{{ 'Mini dulces'|t }} <span data-sp-count="mini"></span></button>
    <button type="button" class="sp-store-browser__tab" data-sp-family="bolleria">{{ 'Bollería'|t }} <span data-sp-count="bolleria"></span></button>
  </div>
  <div class="sp-store-browser__filters" aria-label="{{ 'Filtros de catálogo'|t }}">
    <label>
      <span>{{ 'Sabor'|t }}</span>
      <select data-sp-filter="flavor">
        <option value="all">{{ 'Todos'|t }}</option>
        <option value="chocolate">{{ 'Chocolate'|t }}</option>
        <option value="pistacho">{{ 'Pistacho'|t }}</option>
        <option value="caramelo">{{ 'Caramelo'|t }}</option>
        <option value="fruta">{{ 'Fruta'|t }}</option>
        <option value="citricos">{{ 'Cítricos'|t }}</option>
        <option value="cafe">{{ 'Café'|t }}</option>
        <option value="galleta">{{ 'Galleta'|t }}</option>
        <option value="frutos-secos">{{ 'Frutos secos'|t }}</option>
      </select>
    </label>
    <label>
      <span>{{ 'Ocasión'|t }}</span>
      <select data-sp-filter="occasion">
        <option value="all">{{ 'Todas'|t }}</option>
        <option value="cumpleanos">{{ 'Celebración'|t }}</option>
        <option value="regalo">{{ 'Regalo'|t }}</option>
        <option value="compartir">{{ 'Compartir'|t }}</option>
        <option value="capricho">{{ 'Capricho'|t }}</option>
      </select>
    </label>
    <label>
      <span>{{ 'Estilo'|t }}</span>
      <select data-sp-filter="style">
        <option value="all">{{ 'Todos'|t }}</option>
        <option value="premium">{{ 'Premium'|t }}</option>
        <option value="original">{{ 'Original'|t }}</option>
        <option value="intenso">{{ 'Intenso'|t }}</option>
        <option value="clasico">{{ 'Clásico'|t }}</option>
      </select>
    </label>
    {% if sp_store_options %}
    <label>
      <span>{{ 'Tienda'|t }}</span>
      <select data-sp-store>
        <option value="all">{{ 'Todas las tiendas'|t }}</option>
        {% for store_id, store_label in sp_store_options %}
          <option value="{{ store_id }}">{{ store_label }}</option>
        {% endfor %}
      </select>
    </label>
    {% endif %}
    <button type="button" class="sp-store-browser__reset" data-sp-reset>{{ 'Limpiar filtros'|t }}</button>
    <a class="sp-store-browser__assistant-link" href="/tienda/recomendador" data-sp-recommender-link>{{ 'Abrir chat recomendador'|t }}</a>
  </div>
  <p class="sp-store-browser__status" data-sp-status aria-live="polite"></p>
</section>
{{ page.content }}
<div class="margin_collapsetop"></div>
</div> 
</div> 
<div style="clear:both;">
</div>
</div>
</div>
