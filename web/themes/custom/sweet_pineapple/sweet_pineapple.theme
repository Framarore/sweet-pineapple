'Panaderia y cafe' => 'Panadería y café',
'Cafe delicioso' => 'Café delicioso',
'Envio gratis' => 'Envío gratis',
'Quienes somos' => 'Quiénes somos',
'Reposteria para todos' => 'Repostería para todos',
'MAXIMA CALIDAD' => 'MÁXIMA CALIDAD',
'ENTREGA RAPIDA' => 'ENTREGA RÁPIDA',
'RESERVA EN LINEA' => 'RESERVA EN LÍNEA',
'Atencion 24/7' => 'Atención 24/7',
'Como tu panaderia de barrio, siempre estamos ahi' => 'Como tu panadería de barrio, siempre estamos ahí',
'Leer mas' => 'Leer más',
'PAGINAS' => 'PÁGINAS',
'LLAMANOS AL' => 'LLÁMANOS AL',
'Sabado - Domingo' => 'Sábado - Domingo',
'Creemos en un mundo en el que tengas total libertad para ser tu mismo, sin juicios. Para experimentar. Para expresarte. Para ser valiente y vivir la vida como la extraordinaria aventura que es. Por eso nos aseguramos de que todo el mundo tenga la misma oportunidad de descubrir todo lo increible de lo que es capaz, sin importar quien sea, de donde venga o el estilo que prefiera. Estamos aqui para darte la confianza de ser quien quieras ser.' => 'Creemos en un mundo en el que tengas total libertad para ser tú mismo, sin juicios. Para experimentar. Para expresarte. Para ser valiente y vivir la vida como la extraordinaria aventura que es. Por eso nos aseguramos de que todo el mundo tenga la misma oportunidad de descubrir todo lo increíble de lo que es capaz, sin importar quién sea, de dónde venga o el estilo que prefiera. Estamos aquí para darte la confianza de ser quien quieras ser.',
'Nuestra clientela, es decir, tu, es maravillosamente unica. Y hacemos todo lo posible para ayudarte a encontrar lo que mejor encaja contigo, ofreciendo nuestras colecciones en mas de 30 tallas y manteniendo el mismo precio en todas ellas, para que tengas la seguridad de que tenemos la opcion perfecta para ti. Tambien nos enorgullece colaborar con GLAAD, una de las voces mas importantes del activismo LGBTQ, en una coleccion neutra en cuanto al genero para avanzar juntos en la aceptacion.' => 'Nuestra clientela, es decir, tú, es maravillosamente única. Y hacemos todo lo posible para ayudarte a encontrar lo que mejor encaja contigo, ofreciendo nuestras colecciones en más de 30 tallas y manteniendo el mismo precio en todas ellas, para que tengas la seguridad de que tenemos la opción perfecta para ti. También nos enorgullece colaborar con GLAAD, una de las voces más importantes del activismo LGBTQ, en una colección neutra en cuanto al género para avanzar juntos en la aceptación.',
'Tenemos todo tu pan tradicional favorito, los 7 dias de la semana. Puedes elegir entre una gran variedad de galletas, bolleria y tartas.' => 'Tenemos todo tu pan tradicional favorito, los 7 días de la semana. Puedes elegir entre una gran variedad de galletas, bollería y tartas.',
'Nos especializamos en tartas personalizadas para todo tipo de ocasiones. Puedes elegir entre varios disenos para crear la tarta perfecta para ti.' => 'Nos especializamos en tartas personalizadas para todo tipo de ocasiones. Puedes elegir entre varios diseños para crear la tarta perfecta para ti.',
'Desde elegantes tartas de boda hasta deliciosas cestas de regalo, podemos ayudarte a crear una celebracion unica y perfecta.' => 'Desde elegantes tartas de boda hasta deliciosas cestas de regalo, podemos ayudarte a crear una celebración única y perfecta.',
];
foreach (Node::loadMultiple() as $node) {
if ($node->bundle() !== 'page') {
continue;
}
foreach (array_keys($node->getTranslationLanguages()) as $langcode) {
$translation = $node->getTranslation($langcode);
$title = $translation->label();
if (isset($node_title_map[$title])) {
$translation->setTitle($node_title_map[$title]);
}
if (!$translation->get('body')->isEmpty()) {
$body = $translation->get('body')->value;
$body = strtr($body, $body_map);
$translation->set('body', [
'value' => $body,
'format' => $translation->get('body')->format ?: 'full_html',
]);
}
}
$node->save();
}
$menu_links = \Drupal::entityTypeManager()->getStorage('menu_link_content')->loadByProperties(['menu_name' => 'tt-menu']);
foreach ($menu_links as $menu_link) {
foreach (array_keys($menu_link->getTranslationLanguages()) as $langcode) {
$translation = $menu_link->getTranslation($langcode);
$title = $translation->label();
if (isset($menu_title_map[$title])) {
$translation->set('title', $menu_title_map[$title]);
}
}
$menu_link->save();
}
foreach (BlockContent::loadMultiple() as $block) {
if (!$block->hasField('body')) {
continue;
}
foreach (array_keys($block->getTranslationLanguages()) as $langcode) {
$translation = $block->getTranslation($langcode);
if ($translation->get('body')->isEmpty()) {
continue;
}
$body = $translation->get('body')->value;
$body = strtr($body, $body_map);
$translation->set('body', [
'value' => $body,
'format' => $translation->get('body')->format ?: 'full_html',
]);
}
$block->save();
}
$state->set('sweet_pineapple_translation_update_version', $update_version);
}
function sweet_pineapple_preprocess_page_title(&$variables) {
$node = Drupal::request()->attributes->get('node');
if (isset($node) && method_exists($node, 'getType') && $node->getType() == 'article') {
$variables['title_prefix'] = array('#markup' => '<div class="tt_article_title_hidden">');
$variables['title_suffix'] = array('#markup' => '</div>');
}
if ( $node !== null && $node->id() ){
$variables['node_id'] = $node->id();
}
}
function sweet_pineapple_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) { 
if (str_starts_with($form_id, 'commerce_checkout_flow_')) {
  $gateway = \Drupal::entityTypeManager()->getStorage('commerce_payment_gateway')->load('pago_de_ejemplo_tarjeta');
  if ($gateway && $gateway->status() && $gateway->getPluginId() === 'example_onsite') {
    $form['sp_demo_payment_notice'] = [
      '#type' => 'container',
      '#weight' => -100,
      '#attributes' => ['class' => ['messages', 'messages--warning', 'sp-demo-payment-notice'], 'role' => 'note'],
      'message' => ['#markup' => t('Compra de demostración: el pago de ejemplo es simulado y no realiza cargos. No introduzcas datos de una tarjeta real.')],
    ];
  }
}
$form['actions']['submit']['#attributes']['class'][] = 'btn btn-default'; 
$form['actions']['preview']['#attributes']['class'][] = 'btn btn-default'; 
if (in_array($form_id, ['search_form']) || in_array($form_id, ['search_block_form']) ) 
 {  
	$key = ($form_id == 'search_block_form') ? 'actions' : 'basic';	 
  $form[$key]['submit']['#attributes']['class'][] = 'btn btn-default'; 
	} 
 } 
function sweet_pineapple_preprocess_menu(&$variables, $hook) {
$current_path = \Drupal::request()->getRequestUri();
global $current_region ;
if ($hook == 'menu' || $hook == 'menu__sidebar_first'){ 
$items = $variables['items']; 
foreach ($items as $key => $item)
	{ 
 if ($current_region == 'primary_menu' || ($current_region == 'leftfooterarea' && theme_get_setting('menu_leftfooterarea') == 0) || ($current_region == 'centerfooterarea' && theme_get_setting('menu_centerfooterarea') == 0) || ( $current_region == 'rightfooterarea' && theme_get_setting('menu_rightfooterarea') == 0) 
|| ($current_region == 'slideshowshape000' && theme_get_setting('menu_slideshowshape000') == 0) 
|| ($current_region == 'slideshowshape101' && theme_get_setting('menu_slideshowshape101') == 0) 
|| ($current_region == 'slideshowabovecolumn1' && theme_get_setting('menu_slideshowabovecolumn1') == 0) 
|| ($current_region == 'slideshowabovecolumn2' && theme_get_setting('menu_slideshowabovecolumn2') == 0) 
|| ($current_region == 'slideshowabovecolumn3' && theme_get_setting('menu_slideshowabovecolumn3') == 0) 
|| ($current_region == 'slideshowabovecolumn4' && theme_get_setting('menu_slideshowabovecolumn4') == 0) 
|| ($current_region == 'slideshowbelowcolumn1' && theme_get_setting('menu_slideshowbelowcolumn1') == 0) 
|| ($current_region == 'slideshowbelowcolumn2' && theme_get_setting('menu_slideshowbelowcolumn2') == 0) 
|| ($current_region == 'slideshowbelowcolumn3' && theme_get_setting('menu_slideshowbelowcolumn3') == 0) 
|| ($current_region == 'slideshowbelowcolumn4' && theme_get_setting('menu_slideshowbelowcolumn4') == 0) 
|| ($current_region == 'menuabovecolumn1' && theme_get_setting('menu_menuabovecolumn1') == 0) 
|| ($current_region == 'menuabovecolumn2' && theme_get_setting('menu_menuabovecolumn2') == 0) 
|| ($current_region == 'menuabovecolumn3' && theme_get_setting('menu_menuabovecolumn3') == 0) 
|| ($current_region == 'menuabovecolumn4' && theme_get_setting('menu_menuabovecolumn4') == 0) 
|| ($current_region == 'menubelowcolumn1' && theme_get_setting('menu_menubelowcolumn1') == 0) 
|| ($current_region == 'menubelowcolumn2' && theme_get_setting('menu_menubelowcolumn2') == 0) 
|| ($current_region == 'menubelowcolumn3' && theme_get_setting('menu_menubelowcolumn3') == 0) 
|| ($current_region == 'menubelowcolumn4' && theme_get_setting('menu_menubelowcolumn4') == 0) 
|| ($current_region == 'contenttopcolumn1' && theme_get_setting('menu_contenttopcolumn1') == 0) 
