/* Inicio de la importacion de contenido demo. */
function sweet_pineapple_add_content()
{
	$themeLink = sweet_pineapple_get_theme_path();
	$xml = simplexml_load_file($themeLink.'/content/content.xml');
		$menu_arr = array();
		foreach($xml->menu->menu_item as $menu_name){
			if ((string) $menu_name->menu_item_slug == 'blog-wp') {
				continue;
			}
			array_push(
				$menu_arr,
				array(
					'title'  => (string) $menu_name->menu_item_title,
					'status' => (int) $menu_name->menu_item_status,
					'slug'   => (string) $menu_name->menu_item_slug,
				)
			);
		}
	if(isset($xml->pages->content))	
	{
  /* Copia imagenes del contenido a sites/default/files/inline-images. */
		$fid = 10;
		$file = \Drupal\file\Entity\File::load($fid);
      $path = 'public://inline-images/'; 
		if (\Drupal::service('file_system')->prepareDirectory($path, FileSystemInterface::CREATE_DIRECTORY)) 
		{
	  		if ($file) {
	  			\Drupal::service('file_system')->copy($file->getFileUri(), $path . basename($file->getFileUri()), FileSystemInterface::EXISTS_REPLACE);
	  		}
		}
		$images_dir = $themeLink.'/content/images';
		if (is_dir($images_dir)) {
			$images = \Drupal::service('file_system')->scanDirectory($images_dir,'/.*\.jpg|jpeg|gif|png|pdf|doc|zip|rar|docx|7zip|txt|rtf|odt|7z|ods$/');
		}
		$videos_dir = $themeLink.'/video';
		if (is_dir($videos_dir)) {
			$videos = \Drupal::service('file_system')->scanDirectory($videos_dir,'/.*\.mp4$/');
		}
		if (!isset($images)) {
      $images = [];
    }
		if (!isset($videos)) {
      $videos = [];
    }
		foreach($images as $value)
		{
			\Drupal::service('file_system')->copy($value->uri, 'public://inline-images/' . $value->filename, FileSystemInterface::EXISTS_REPLACE);
		}
		foreach($videos as $value)
		{
			\Drupal::service('file_system')->copy($value->uri, 'public://inline-images/' . $value->filename, FileSystemInterface::EXISTS_REPLACE);
		}
  /* Copia imagenes del contenido a sites/default/files/inline-images. */
		sweet_pineapple_tt_menu();
  /* Lee paginas del XML y crea sus nodos/enlaces. */
		foreach($xml->pages->content as $page_node)
		{
			if(isset($page_node->introtext))
			{
				$properties = (string)$page_node->introtext;
				$base_path = base_path();
				$properties = str_replace('~base_path~', $base_path, $properties);
			}
			$query = \Drupal::entityQuery('node')->accessCheck(FALSE);
			$query->condition('title', $page_node->page_title);
			$query->condition('type', 'page');	
			$pageTitle = $query->execute();
			$parent = NULL;
			$nodeExist = false;
  /* Comprueba si el nodo ya existe. */
			$aliasnode = \Drupal::entityTypeManager()->getStorage('node')->loadByProperties(['title' => $page_node->page_title]);
			if($aliasnode)
			{
          	foreach($aliasnode as $nidKey => $nidValue)
          	{
          		if (((int) \Drupal::VERSION) < 9)
          		{
              	$alias = \Drupal::service('path.alias_manager')->getAliasByPath('/node/'.$nidKey);
          		}
          		else
          		{
              		$alias = \Drupal::service('path_alias.manager')->getAliasByPath('/node/'.$nidKey);
          		}
					if($alias == '/' . $page_node->alias)
            		{
                		$nodeExist = True; 
           		}
       		}
    		}
  /* Obtiene el padre del enlace si existe. */
			foreach($xml->menu->menu_item as $menu_name)
			{
			if ((string) $menu_name->menu_item_slug == 'blog-wp') {
				continue;
			}
			if($menu_name->menu_item_title == (string)$page_node->page_name && isset($menu_name->menu_item_parent))
			    {
			    	$page_node_title = $menu_name->menu_item_parent;
			    	$menu_nid = \Drupal::entityTypeManager()->getStorage('menu_link_content')->loadByProperties(['title' => $page_node_title]);
			        foreach($menu_nid as $menu_nidKey => $menu_nidValue)
			        {
			            $menu_link = MenuLinkContent::load($menu_nidKey);
						$parent = 'menu_link_content:' . $menu_link->uuid();
						break;
			        } 
			    }
			}
  /* Si el nodo existe, actualiza sus datos. */
	$schema = Database::getConnection()->schema();
	$tt_node_field_data = $schema->fieldExists('node_field_data', 'TT_ID');
			if($tt_node_field_data && reset($pageTitle) && $nodeExist)
			{
				$nid = \Drupal::entityTypeManager()
		  				->getStorage('node')
		  				->loadByProperties(['title' => $page_node->page_title]);
				foreach($nid as $nidKey => $nidValue)
				{
					$node = Node::load($nidKey);
				}
				$node->body->value = $properties;
				$node->path = array('alias' => '/' . $page_node->alias, 'pathauto' => 0);
				$resetNode = $node->save();	
				if($resetNode)
				{
					$state = true;
					Database::getConnection()->update('node_field_data')
            ->fields(['TT_ID' => 1])
            ->condition('title', (string) $page_node->page_title)
            ->execute();
				}
				else
				{
					$state = false;
				}
			}
      else /* Si la pagina no existe, la crea. */
			{
				$node = \Drupal\node\Entity\Node::create(
					array(
					'type' => 'page',
					'title' =>  (string)$page_node->page_title,
					'base' => 'node_content',
					'body' => [	
						'value' => $properties,
						'format' => 'full_html',
		  			],
					'custom' => 1,
					'modified' => 1,
					'locked' => 0,
					'path' =>  ['alias' => '/' . $page_node->alias]
					));
				if($node->save())
				{
						$state = true;
				}
				else
				{
					$state = false;
				}
			}
 $singlepage = false;
 if ($singlepage){
  /* Genera enlaces para secciones de pagina. */
			$i = 0;
 		foreach($xml->menu->menu_item as $menu_name){
			if ((string) $menu_name->menu_item_slug == 'blog-wp') {
				continue;
			}
			$weight = -100 + $i;
			$links = \Drupal::entityTypeManager()->getStorage('menu_link_content')->loadByProperties(['title' => (string)$menu_name->menu_item_title]);
			if(!$links)
			{
				if ((string)$menu_name->menu_item_url == null){
					$link = '/<front>';
					$config = \Drupal::configFactory()->getEditable('system.site');
					$config->set('page.front', '/node/'.$node->id().$menu_name->menu_item_url)->save();
					}
					else{
					$link = '/'.$menu_name->menu_item_url;
					 }
				$create_menu = MenuLinkContent::create([
					'title' => (string)$menu_name->menu_item_title,
					'expanded' => TRUE,
					'link' => ['uri' => 'internal:'.$link],
					'menu_name' => 'tt-menu',
					'weight' => $weight,
					'parent' => $parent,
					'enabled' => 1,
					]);
				if($create_menu->save())
				{
						$fieldSpec = array(
					    	'type' => 'int',
					    	'size' => 'small',
					    	'not null' => TRUE,
					    	'default' => 0,
					    	'description' => 'TT id for TemplateToaster themes.',
					  		);
					$schema = Database::getConnection()->schema();
					if (!$schema->fieldExists('node_field_data', 'TT_ID')) {
						$schema->addField('node_field_data', 'TT_ID', $fieldSpec);
					} else {
						Database::getConnection()->update('node_field_data')
              ->fields(['TT_ID' => 1])
              ->condition('nid', $node->id())
              ->execute();
					}
					$state = true;
				}
				else
				{
					$state = false;
				}
			}
			else{
				if ((string)$menu_name->menu_item_url == null){
					$link = '/<front>';
					$config = \Drupal::configFactory()->getEditable('system.site');
					$config->set('page.front', '/node/'.$node->id().$menu_name->menu_item_url)->save();
					}
					else{
					$link = '/'.$menu_name->menu_item_url;
					 }
				$linkobj = reset($links);
				$oldweight = $linkobj->getWeight();
				$linkobj->set('weight', $weight);
				$linkobj->set('enabled', 1);
				$linkobj->set('link', 'internal:'.$link);
				$linkobj->set('parent', $parent);
				$linkobj->save();
			}
			$i++;
  	}
 }
	else{
			$weight = -100;
          $item = (string)$page_node->alias;
          $order = array_search($item, array_column($menu_arr, 'slug'));
          if($order === FALSE){
          	$enabled = 0;
          }else{
          $enabled = $menu_arr[ $order ]['status'];
          $weight += $order ;
				}
  /* Genera enlaces para nodos de pagina. */
			$links = \Drupal::entityTypeManager()->getStorage('menu_link_content')->loadByProperties(['link__uri' => 'internal:/node/'.$node->id()]);
			if(!$links)
			{
				if ((string)$page_node->page_header_id == 'home'){
					$link = '/<front>';
					$config = \Drupal::configFactory()->getEditable('system.site');
					$config->set('page.front', '/node/'.$node->id())->save();
					}
					else{
					$link = '/node/'.$node->id();
					 }
				$create_menu = MenuLinkContent::create([
					'title' => (string)$page_node->page_name,
					'expanded' => TRUE,
					'link' => ['uri' => 'internal:'.$link],
					'menu_name' => 'tt-menu',
					'weight' => $weight,
					'parent' => $parent,
					'enabled' => $enabled,
					]);
				if($create_menu->save())
				{
						$fieldSpec = array(
					    	'type' => 'int',
					    	'size' => 'small',
					    	'not null' => TRUE,
					    	'default' => 0,
					    	'description' => 'TT id for TemplateToaster themes.',
					  		);
				$schema = Database::getConnection()->schema();
				if (!$schema->fieldExists('node_field_data', 'TT_ID'))
				{
					$schema->addField('node_field_data', 'TT_ID', $fieldSpec);
				}
				else
				{
					Database::getConnection()->update('node_field_data')
            ->fields(['TT_ID' => 1])
            ->condition('nid', $node->id())
            ->execute();
				}
					$state = true;
				}
				else
				{
					$state = false;
				}
			}
			else{
				if ((string)$page_node->page_header_id == 'home'){
					$link = '/<front>';
					$config = \Drupal::configFactory()->getEditable('system.site');
					$config->set('page.front', '/node/'.$node->id())->save();
					}
					else{
					$link = '/node/'.$node->id();
					 }
				$linkobj = reset($links);
				$oldweight = $linkobj->getWeight();
				$linkobj->set('weight', $weight);
				$linkobj->set('enabled', $enabled);
				$linkobj->set('link', 'internal:'.$link);
				$linkobj->set('parent', $parent);
				$linkobj->save();
			}
	}
		if (((int) \Drupal::VERSION) < 9)
		{
			$alias = \Drupal::service('path.alias_manager')->getAliasByPath('/node/'.$node->id());
		}
		else
		{
			$alias = \Drupal::service('path_alias.manager')->getAliasByPath('/node/'.$node->id());
		}
			$alias = ltrim($alias, '/');
		$tt_nodes = array(
		'home', 
		);
		if (!in_array($alias,$tt_nodes) && $alias != 'home')
  	{
		$droot = \Drupal::root();
		$theme_root = $droot . '/' . sweet_pineapple_get_theme_path();
		$location =  $theme_root . '/templates/';
		if (\Drupal::service('file_system')->prepareDirectory($location, FileSystemInterface::CREATE_DIRECTORY)) { 
			\Drupal::service('file_system')->copy($theme_root . '/content/' . $alias . '.html.twig', $location . 'page--' . $alias . '.html.twig', FileSystemInterface::EXISTS_REPLACE);
		}
		}
		}
		if ($state)
		{
			sweet_pineapple_delete_nodes();
 			 \Drupal::configFactory()->getEditable('sweet_pineapple.settings')->set('is_content_imported', '1')->save();
   		\Drupal::messenger()->addStatus('Content imported successfully');
		}
		else
		{
			\Drupal::messenger()->addError('Content import is failed. Please, try again.');
	}
	}
	else
	{
		\Drupal::messenger()->addError('No content is available for upload.');
		}
  $theme = \Drupal::config('system.theme')->get('default');
            $system_regions = system_region_list($theme, $show = REGIONS_ALL);
                $blocks = \Drupal::entityTypeManager()->getStorage('block')->loadByProperties(array('provider' => 'block_content'));
                uasort($blocks, 'Drupal\block\Entity\Block::sort');
                $build = array();
                foreach ($blocks as $key => $block) {
                    $trr = substr($key, -4);
                    if ($trr == '_ttr') {
						$bid = $block->getPluginId();
			            $block->delete();
						$bid = str_replace('block_content:','', $bid);
						$blockcontent  = \Drupal::service('entity.repository')->loadEntityByUuid('block_content', $bid);
                      if ($blockcontent){
							$blockcontent->delete();
							}
                   	 }
                    }
  /* Lee paginas del XML y crea sus nodos/enlaces. */
  /* Crea bloques laterales. */
	if(isset($xml->sidebars->sidebar->block))
	{
		foreach($xml->sidebars->sidebar as $sidebars)
		{
			foreach($sidebars->block as $sidebar_block)
			{
				$w_page = null;
				foreach($sidebar_block->widget_pages->widget_page as $page)
				{
				if ((string)$page == 'blog-wp')
				{
					$w_page .=  '
<front>';
				}else{
					$w_page .=  '
/'.$page;
				}
				}
				$sidebarRegion = $sidebars[0];
				$region = $sidebarRegion->attributes()->name;
				$title = (string)$sidebar_block[0]->attributes()->title;
				$tt_blockID = str_replace(' ', '_', $title);
				$tt_blockID = preg_replace('/[^a-zA-Z0-9_.]/', '', $tt_blockID);
				$tt_blockID = strtolower($tt_blockID.'_ttr');
				$blockExists = \Drupal\block\Entity\Block::load($tt_blockID);
				if (!$blockExists)
				{
					$createBlock = true;
				}
                else if ($blockExists && $tt_blockID == 'sidebar_menu_ttr')
				{
                    $visibility = $blockExists->getVisibility();
                    $visibility['request_path']['pages'] = $w_page;
                    if ( empty( $w_page) )
                    	{
                    		$visibility['request_path']['negate'] = 1;
                    	}
                    	else 
                    	{
                    		$visibility['request_path']['negate'] = 0;
                    	}
                    $blockExists->setVisibilityConfig('request_path', $visibility['request_path']);
                    $blockExists->setRegion((string)$region);
                    $blockExists->set('theme', 'sweet_pineapple');
				}else{
				continue;}
				if((string)$title == 'Sidebar Menu' && $createBlock)
				{
				   	$block = Block::create([
					         	'id' => $tt_blockID,
					            'plugin' => 'system_menu_block:tt-menu',
					            'region' => (string)$region,
					            'weight' => 0,
					            'theme' => 'sweet_pineapple',
					            'visibility' => [],
					            'settings' => [
					              	'label' => (string)$title,
					              	'label_display' => TRUE,
					               ]
					            ]);
					 $block->save();
                    if (empty($w_page))
                    	{
                    		$visibility['request_path']['negate'] = 1;
                    	}
                    	else 
                    	{
                    		$visibility['request_path']['negate'] = 0;
                    	}
                        $block->setVisibilityConfig('request_path', $visibility['request_path']);
                        $block->save();
				}
				elseif (isset($sidebar_block->content) && $createBlock)
				{
					$body = (string)$sidebar_block->content;
					$base_path = base_path();
					$body = str_replace('~base_path~', $base_path, $body); 
					$block_content = BlockContent::create([
							'info' => $title,
							'type' => 'basic',
							'langcode' => 'en',
							'body' => [
						 		'value' => (string)$body,
						 		'format' => 'full_html',
							],
					]);
					$basic_block = $block_content->save();
					if($basic_block)
					{
						$block = Block::create([
								'id' => $tt_blockID,
								'plugin' => 'block_content:' . $block_content->uuid(),
								'region' => (string)$region,
								'provider' => 'block_content',
								'weight' => 1,
								'theme' => 'sweet_pineapple',
								'visibility' => [],
								'settings' => [
									'label' => $title,
									'label_display' => TRUE,
								]
							]);
						$block->save();
						  $visibility['request_path']['pages'] = $w_page;
                        $visibility['request_path']['negate'] = 0;
                        $block->setVisibilityConfig('request_path', $visibility['request_path']);
                        $block->save();
					}
				}
			}
		}
	}
  /* Crea bloques del pie. */
	if(isset($xml->footers->footer->block))
	{
		foreach($xml->footers->footer as $cells)
		{
sweet_pineapple_add_blocks($cells);
		}
	}
  /* Crea bloques de texto de cabecera. */
	if(isset($xml->Shapes->headershapes->header->block))
	{
		foreach($xml->Shapes->headershapes->header as $cells)
		{
sweet_pineapple_add_blocks($cells);
		}
	}
  /* Crea bloques de texto del menu. */
	if(isset($xml->Shapes->menushapes->menu->block))
	{
		foreach($xml->Shapes->menushapes->menu as $cells)
		{
sweet_pineapple_add_blocks($cells);
		}
	}
  /* Crea bloques de texto del menu. */
	if(isset($xml->Shapes->slideshowshapes->slideshow->block))
	{
		foreach($xml->Shapes->slideshowshapes->slideshow as $cells)
		{
sweet_pineapple_add_blocks($cells);
		}
	}
  /* Crea bloques de texto del pie. */
	if(isset($xml->Shapes->footershapes->footer->block))
	{
		foreach($xml->Shapes->footershapes->footer as $cells)
		{
sweet_pineapple_add_blocks($cells);
		}
	}
}
/* Borra enlaces de nodos que ya no existen en el XML. */
function sweet_pineapple_add_blocks($cells)
{
			foreach($cells->block as $cell_block)
			{
				$w_page = null;
				foreach($cell_block->widget_pages->widget_page as $page)
				{
				if ((string)$page == 'blog-wp')
				{
					$w_page .=  '
/blog';
					$w_page .=  '
/node/*';
				}else{
					$w_page .=  '
/'.$page;
				}
				}
				$sidebarRegion = $cells[0];
				$region = $sidebarRegion->attributes()->name;
				$title = (string)$cell_block[0]->attributes()->title;
				$tt_blockID = str_replace(' ', '_', $title);
				$tt_blockID = preg_replace('/[^a-zA-Z0-9_.]/', '', $tt_blockID);
				$tt_blockID = strtolower($tt_blockID.'_ttr');
				$blockExists = \Drupal\block\Entity\Block::load($tt_blockID);
				if (!$blockExists)
				{
					$createBlock = true;
				}else{
				continue;}
				if (isset($cell_block->content) && $createBlock)
				{
					$body = (string)$cell_block->content;
					$base_path = base_path();
					$body = str_replace('~base_path~', $base_path, $body); 
					$block_content = BlockContent::create([
							'info' => $title,
							'type' => 'basic',
							'langcode' => 'en',
							'body' => [
						 		'value' => (string)$body,
						 		'format' => 'full_html',
							],
					]);
					$basic_block = $block_content->save();
					if($basic_block)
					{
						$block = Block::create([
								'id' => $tt_blockID,
								'plugin' => 'block_content:' . $block_content->uuid(),
								'region' => (string)$region,
								'provider' => 'block_content',
								'weight' => 0,
								'theme' => 'sweet_pineapple',
								'visibility' => [],
								'settings' => [
									'label' => $title,
									'label_display' => FALSE,
								]
							]);
						$block->save();
						  $visibility['request_path']['pages'] = $w_page;
                        $visibility['request_path']['negate'] = 0;
                        $block->setVisibilityConfig('request_path', $visibility['request_path']);
                        $block->save();
					}
				}
			}
		}
/* Borra enlaces de nodos que ya no existen en el XML. */
function sweet_pineapple_delete_nodes()
{
	$themeLink = sweet_pineapple_get_theme_path();
	$xml = simplexml_load_file($themeLink.'/content/content.xml');
	$pageNodes = array();
	foreach($xml->pages->content as $page_node)
	{
		array_push($pageNodes, $page_node->page_name); 
	}
	$storage = \Drupal::entityTypeManager()->getStorage('menu_link_content');
	$menu_links = $storage->loadByProperties(['menu_name' => 'tt-menu']);
	foreach ($menu_links as $menu_link)
	{
		$title = $menu_link->getTitle();
		$nid = \Drupal::entityTypeManager()
 			->getStorage('node')
 			->loadByProperties(['title' => $title]);
		foreach($nid as $nidKey => $nidValue)
		{
			$node_link = Node::load($nidKey);
			if (!in_array($title, $pageNodes))
			{
				$node_link->delete();
			}
		}
	}
/* Crea la pagina de blog si no existe. */
	$count = count($xml->menu->menu_item);
	$last_item = $xml->menu->menu_item[$count-1];
	$blog_page = \Drupal::entityTypeManager()->getStorage('menu_link_content')->loadByProperties(['title' => 'Blog']);
	if( !$blog_page)
	{
		$item = \Drupal\menu_link_content\Entity\MenuLinkContent::create([
				  'link' => ['uri' => 'internal:/node'],
				  'title' => 'Blog',
				  'menu_name' => 'tt-menu',
				  'expanded' => TRUE,
				  'enabled' => (int) $last_item->menu_item_status,
				]);
		$item->save();
	}
	else{
		$linkobj = reset($blog_page);
		$linkobj->set('link', 'internal:/node');
		$linkobj->save();
		}
	//	 \Drupal::service('pathauto.generator')->updateEntityAlias($entity, 'update');
	if (((int) \Drupal::VERSION) < 9) {
		 $blog_alias = \Drupal::service('path.alias_storage')->save('/node', '/blog', 'en');
  } else { 
		$blog_alias =\Drupal::entityTypeManager()->getStorage('path_alias')->create([
			'path' => '/node',
			'alias' => '/blog',
			'langcode' => 'en',
			]);
	$blog_alias->save();
 }
}
/* Asigna alias a todos los enlaces de menu. */
function sweet_pineapple_preprocess_html(&$variables) {
  if (\Drupal::moduleHandler()->moduleExists('commerce_cart')) {
    $variables['attributes']['class'][] = 'sp-has-cart';
    // Commerce's placeholder keeps the cart specific to the current session.
    $variables['sp_cart_summary'] = \Drupal::service('plugin.manager.block')
      ->createInstance('commerce_cart', ['dropdown' => FALSE, 'show_if_empty' => TRUE])
      ->build();
  }
	$current_path = \Drupal::service('path.current')->getPath();
	$normalized_current_path = ltrim($current_path, '/');
	if (((int) \Drupal::VERSION) < 9)
  {
	$path_alias = \Drupal::service('path.alias_manager')->getAliasByPath($current_path);
	}
	else
	{
		$path_alias = \Drupal::service('path_alias.manager')->getAliasByPath($current_path);
	}
	if ($path_alias == $current_path)
	{
		$path_alias = 'blog';
	}
	else
	{
		$path_alias = ltrim($path_alias, '/');
	}
/* Quita el menu principal duplicado de la region primary_menu. */
	$variables['attributes']['class'][] = \Drupal\Component\Utility\Html::cleanCssIdentifier($path_alias);
	if ($normalized_current_path === 'tienda') {
		$variables['attributes']['class'][] = 'shop';
	}
	if (isset($variables['page']['primary_menu']['sweet_pineapple_main_menu'])) 
	{
		unset($variables['page']['primary_menu']['sweet_pineapple_main_menu']);
	}
}
/* Crea el menu propio heredado de TemplateToaster. */
function sweet_pineapple_tt_menu() {
	$menu = \Drupal\system\Entity\Menu::load('tt-menu');
	if($menu)
	{
		$menu->delete();
		$menu = Menu::create([
			'id' => 'tt-menu',
			'label' => 'sweet_pineapple Menu',
			'description' => 'TemplateToaster custom menu module.',
			'theme' => 'sweet_pineapple',
			'status' => TRUE
			]);
		$menu->save();
	}
 else{
		$menu = Menu::create([
			'id' => 'tt-menu',
			'label' => 'sweet_pineapple Menu',
			'description' => 'TemplateToaster custom menu module.',
			'theme' => 'sweet_pineapple',
			'status' => TRUE
			]);
		$menu->save();
}
	$menuBlock = \Drupal\block\Entity\Block::load('tt-menu_block');
	if(!$menuBlock)
	{
  	$menuBlock = Block::create([
					'plugin' => 'system_menu_block:tt-menu',
					'region' => 'primary_menu',
					'weight' => 1,
					'theme' => 'sweet_pineapple',
					'id' => 'tt-menu_block',
					'settings' => [
						'label' => 'sweet_pineapple Menu',
						'label_display' => FALSE,
						]
					]);
		$menuBlock->save();
	} 
}
/* Sugiere la plantilla de pagina segun el alias del nodo. */
function sweet_pineapple_theme_suggestions_page_alter(array &$suggestions, array $vars)
{
$alias = '';
	$current_path = \Drupal::service('path.current')->getPath();
	$frontPage = \Drupal::service('path.matcher')->isFrontPage();
	if (!$frontPage)
	{
		$node = \Drupal::request()->attributes->get('node');
		if ($current_path === '/tienda') {
		$alias = 'tienda';
		}
		elseif ($node == null){
		$alias = 'blog';
		}
		else{
			if (((int) \Drupal::VERSION) < 9)
			{
		$alias = \Drupal::service('path.alias_manager')->getAliasByPath('/node/'.$node->id());
		}
			else
			{
				$alias = \Drupal::service('path_alias.manager')->getAliasByPath('/node/'.$node->id());
			}
		}
		}
		$tt_nodes = array(
		'home', 
		);
 		if (in_array($alias,$tt_nodes) || $alias == 'blog')
  	{
			$suggestions[] = 'page--node';
		}
		elseif (!empty($alias))
		{
			$suggestions[] = 'page__' . str_replace('-', '_', $alias);
		}
	}
/* Fin de la importacion de contenido demo. */
function sweet_pineapple_theme_suggestions_block_alter(array &$suggestions, array $variables) {
		$base_plugin_id = $variables['elements']['#base_plugin_id'];
		$system_menu_block = $base_plugin_id == 'system_menu_block';
		if ($system_menu_block) {
		 $id = $variables['elements']['#id'];
		 $block = Block::load($id);
		 $region = $block->get('region');
		 $suggestions[] = 'block__' . $region . '__menu';
		 }
		} 
function sweet_pineapple_preprocess_block__sidebar_first__menu(&$variables) {
		 $variables['content']['#theme'] = 'menu__sidebar_first';
		}
function sweet_pineapple_preprocess_breadcrumb(&$variables) {
if ($variables['breadcrumb']) {
$request = \Drupal::request();
$route_match = \Drupal::routeMatch();
$page_title = \Drupal::service('title_resolver')->getTitle($request, $route_match->getRouteObject());
if (!empty($page_title)) {
$variables['breadcrumb'][] = [
'text' => $page_title,
'attributes' => new Attribute(['class' => ['active']])
];
}
}
}
